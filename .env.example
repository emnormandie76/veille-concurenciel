# ═══════════════════════════════════════════════════════════════════════════
#  Veille Concurrentiel — variables d'environnement
# ═══════════════════════════════════════════════════════════════════════════
#
#  Copier ce fichier en `.env.local` (Next.js) et en `backend/.env` (FastAPI),
#  puis renseigner les valeurs. Aucune valeur réelle ne doit être commitée.
#
#  Légende :  [REQUIS]  l'application ne démarre pas sans
#             [PROD]    requis en production uniquement
#             [OPTION]  a un défaut raisonnable
#
#  Ce fichier a été produit à l'étape 6 de l'audit technique. Auparavant, aucune
#  des variables n'était documentée à la racine : il fallait parcourir
#  docs/architecture/task.md pour en reconstituer la liste.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  BASE DE DONNÉES  (Next.js + FastAPI)
# ───────────────────────────────────────────────────────────────────────────

# [REQUIS] Connexion applicative. Sur Neon, l'URL du pooler (PgBouncer).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# [REQUIS] Connexion directe, sans pooler — utilisée par le CLI Prisma.
# PgBouncer ne supporte pas les migrations.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# [OPTION] Base jetable pour `prisma migrate dev` et
# `prisma migrate diff --from-migrations`. Prisma 7 EXIGE cette variable pour
# régénérer une migration depuis l'historique. Sans elle, il en crée une à la
# volée sur le serveur.
# SHADOW_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/shadow?sslmode=require"


# ───────────────────────────────────────────────────────────────────────────
#  AUTHENTIFICATION  (Next.js)
# ───────────────────────────────────────────────────────────────────────────

# [REQUIS] Secret de signature des JWT NextAuth. Générer avec :
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# [REQUIS EN PROD] URL publique de l'application. NextAuth v4 en a besoin pour
# construire ses URLs de rappel. Absente du code, elle n'en est pas moins
# obligatoire.
NEXTAUTH_URL="http://localhost:3000"

# [REQUIS pour `prisma db seed`] Mot de passe du compte administrateur initial.
# 12 caractères minimum, 72 octets maximum (limite bcrypt).
# Le seed ÉCHOUE si cette variable est absente : il n'existe plus de mot de
# passe par défaut. Voir docs/architecture/architecture.md §3.6.
SEED_ADMIN_PASSWORD=""

# [OPTION] Identifiant du compte administrateur initial. Défaut : admin
# SEED_ADMIN_USERNAME="admin"


# ───────────────────────────────────────────────────────────────────────────
#  LIAISON Next.js ↔ FastAPI
# ───────────────────────────────────────────────────────────────────────────

# [REQUIS] URL du backend FastAPI, vue depuis Next.js.
FASTAPI_URL="http://localhost:8000"

# [REQUIS] Jeton partagé de l'API interne. MÊME VALEUR des deux côtés.
#
# ⚠️  Ce secret portait trois noms : Next.js envoyait FASTAPI_INTERNAL_TOKEN,
#     FastAPI attendait INTERNAL_API_TOKEN ou INTERNAL_TOKEN. INTERNAL_API_TOKEN
#     est désormais le nom canonique ; les deux autres restent acceptés, mais
#     sont à supprimer de vos environnements.
INTERNAL_API_TOKEN=""


# ───────────────────────────────────────────────────────────────────────────
#  LIMITATION DE DÉBIT  (Next.js)
# ───────────────────────────────────────────────────────────────────────────

# [PROD — fortement recommandé] Magasin partagé pour les compteurs de débit.
# Sans lui, le repli mémoire s'applique : chaque démarrage à froid d'une
# fonction serverless repart d'un compteur vide, et le plafond ne tient plus.
# Vercel KV expose la même API REST.
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""


# ───────────────────────────────────────────────────────────────────────────
#  CROWDSOURCING  (Next.js)
# ───────────────────────────────────────────────────────────────────────────

# [OPTION] Domaines acceptés en plus de celui de l'école ciblée, séparés par des
# virgules. Sans eux, une contribution ne peut citer QUE le site de l'école —
# ce qui rend les catégories Ranking et Accreditation difficiles à alimenter.
# CONTRIBUTION_ALLOWED_DOMAINS="ft.com,letudiant.fr,lefigaro.fr,cti-commission.fr,cge.asso.fr"


# ═══════════════════════════════════════════════════════════════════════════
#  BACKEND FastAPI  —  à placer dans backend/.env
# ═══════════════════════════════════════════════════════════════════════════

# [REQUIS] Même valeur que ci-dessus.
# DATABASE_URL="..."
# INTERNAL_API_TOKEN="..."

# [REQUIS] Clé de l'API Google Gemini / Gemma.
GEMINI_API_KEY=""

# [REQUIS] Clés Tavily. Trois formats acceptés, dans cet ordre de priorité :
#   TAVILY_API_KEYS="cle1,cle2,cle3"     — plusieurs clés en rotation
#   TAVILY_API_KEY_1 … TAVILY_API_KEY_10 — une variable par clé
#   TAVILY_API_KEY                        — clé unique
TAVILY_API_KEY=""

# [PROD — REQUIS] Bascule d'environnement. Tant qu'elle ne vaut pas
# "production", /docs, /redoc et /openapi.json restent OUVERTS et publient la
# surface complète de l'API interne.
ENVIRONMENT="development"

# [PROD — REQUIS] Origines autorisées en CORS, séparées par des virgules.
# En production, si elle est absente, AUCUNE origine croisée n'est acceptée et
# une erreur est journalisée au démarrage. Les appels serveur à serveur
# (Next.js → FastAPI) ne passent pas par CORS et ne sont pas concernés.
ALLOWED_ORIGINS="http://localhost:3000"

# [OPTION] Cadencement des tâches périodiques.
# CRON_PHASE1_INTERVAL_HOURS=168             # cartographie, défaut 1 semaine
# CRON_PHASE2_INTERVAL_HOURS=24              # enrichissement, défaut 1 jour
# CRON_PHASE1_INITIAL_DELAY_MINUTES=5        # 1er passage après démarrage
# CRON_CROWDSOURCING_INTERVAL_MINUTES=1      # traitement des contributions

# [OPTION] Retention des tickets de contribution en echec.
# Voir docs/memory/decision-retention-tickets.md
# Attention au cout : chaque tentative relance une extraction Tavily facturee.
# CROWDSOURCING_MAX_ATTEMPTS=3               # tentatives avant suppression
# CROWDSOURCING_RETRY_DELAY_MINUTES=60       # delai avant nouvelle tentative
# PHASE2_MAX_PROGRAMS=10                     # programmes traités par passage
