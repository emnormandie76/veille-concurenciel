// schema.prisma — Source de vérité : bdd.md (immuable)
// ⚠️ Ne JAMAIS créer de table Master, Bachelor, BTS — tout est un Program
// ⚠️ Toujours utiliser upsert() lors du transfert ContributionInbox → tables rigides

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url est défini dans prisma.config.ts (Prisma v7)
}

// ------------------------------------------------------
// AUTHENTIFICATION ET RÔLES
// ------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  password_hash String   // bcrypt
  role          String   @default("MODERATOR") // "ADMIN" | "MODERATOR"
  createdAt     DateTime @default(now())
}

// ------------------------------------------------------
// ENTITÉS PRINCIPALES (Immuables)
// ------------------------------------------------------

model School {
  id              String  @id @default(uuid())
  name            String  @unique
  official_domain String  @unique
  status          String  @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT

  campuses       Campus[]
  statsRecords   SchoolStatsRecord[]
  accreditations AccreditationRecord[]
  cronTargets    CronTarget[]
}

model Campus {
  id       String  @id @default(uuid())
  schoolId String
  name     String  // ex: "Campus Paris La Défense"
  city     String? // ex: "Paris"

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programs Program[]

  @@unique([schoolId, name])
}

model Program {
  id                        String  @id @default(uuid())
  campusId                  String
  name                      String  // ex: "Programme Grande École"
  admission_exam            String? // ex: "Concours Sésame"
  is_alternance_possible    Boolean @default(false)
  is_expatriation_mandatory Boolean @default(false)
  min_expatriation_months   Int?
  max_internship_months     Int?

  campus          Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  pricingRecords  PricingRecord[]
  capacityRecords CapacityRecord[]
  rankingRecords  RankingRecord[]
  cronTargets     CronTarget[]

  @@unique([campusId, name])
}

// ------------------------------------------------------
// TABLES TEMPORELLES "RECORDS" (Données évolutives)
// ------------------------------------------------------

model PricingRecord {
  id                    String  @id @default(uuid())
  programId             String
  academic_year         Int
  currency              String  @default("EUR")
  year_1_fee            Int?    // Edge Case 3 : prix par année, jamais de lissage IA
  year_2_fee            Int?
  year_3_fee            Int?
  year_4_fee            Int?
  year_5_fee            Int?
  total_fee             Int?    // Si le prix est global pour le cursus
  intl_year_1_fee       Int?    // Edge Case 12 : tarif Non-UE séparé
  intl_total_fee        Int?
  intl_currency         String?
  additional_fees_notes String? // Edge Case 8 : frais cachés (dossier, CVEC, asso)
  source_url            String?

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, academic_year])
}

model CapacityRecord {
  id              String  @id @default(uuid())
  programId       String
  academic_year   Int
  spots_available Int
  source_url      String?

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, academic_year])
}

model RankingRecord {
  id            String  @id @default(uuid())
  programId     String
  academic_year Int
  ranking_name  String  // ex: "Le Parisien", "SIGEM", "FT"
  rank          Int
  source_url    String?

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, academic_year, ranking_name])
}

model SchoolStatsRecord {
  id                           String @id @default(uuid())
  schoolId                     String
  academic_year                Int
  total_students               Int?
  total_alumni                 Int?
  partner_companies            Int?
  annual_internship_offers     Int?
  abroad_campuses              Int?
  partner_universities         Int?
  permanent_professors         Int?
  international_professors_pct Float?
  external_speakers_pct        Float?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, academic_year])
}

model AccreditationRecord {
  id                 String  @id @default(uuid())
  schoolId           String
  accreditation_name String  // ex: "EQUIS", "AACSB", "AMBA"
  year_obtained      Int
  is_active          Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, accreditation_name])
}

// ------------------------------------------------------
// PIPELINE IA ET AUTOMATISATION
// ------------------------------------------------------

model ContributionInbox {
  id                    String   @id @default(uuid())
  source_type           String   // "User_Submission" | "Automated_AI"
  schoolId              String?  // FK niveau école (toujours renseigné sauf exceptions)
  campusId              String?  // FK niveau campus (nullable)
  programId             String?  // FK niveau programme (nullable)
  user_text             String?
  urls                  String[] // URLs fournies ou trouvées
  ai_category           String   // "Program_Discovery" | "Pricing" | "Ranking" | "Capacity" | "SchoolStats" | "Accreditation"
  ai_extracted_json     Json?    // JSONB PostgreSQL — résultat brut Gemma
  status                String   @default("Pending_AI") // Pending_AI | Pending_Admin | Validated | Rejected
  year_assumed          Boolean  @default(false)  // Edge Case 2.1
  data_conflict_warning Boolean  @default(false)  // Edge Case 5
  program_name_mismatch Boolean  @default(false)  // Edge Case 6
  createdAt             DateTime @default(now())
  // Note FK : Pour "Program_Discovery" (Phase 1), seul schoolId est renseigné.
  // Pour SchoolStats/Accreditation : campusId/programId = null.
  // Pour Pricing/Ranking/Capacity : les 3 FK sont renseignées.
}

model CronTarget {
  id                    String    @id @default(uuid())
  schoolId              String
  programId             String?
  data_category         String    // "Program_Discovery" | "Pricing" | "Ranking" | "Capacity"
  last_failed_attempt   DateTime?
  failed_attempts_count Int       @default(0)  // Edge Case 4 : blacklist après 3 échecs
  is_blacklisted        Boolean   @default(false)

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([schoolId, programId, data_category])
}
