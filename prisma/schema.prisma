generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  // Ancien identifiant de connexion : seuls les comptes d'avant la liste
  // blanche en ont un, et il ne sert que tant qu'ils n'ont pas d'adresse (D3).
  username        String?   @unique
  // Adresse de travail, en minuscules (D5 : domaine impose par lib/accounts.ts).
  email           String?   @unique
  // Nom affiche, choisi a la premiere connexion (D6).
  display_name    String?
  // Vide tant que la personne n'a pas fait sa premiere connexion (G5, D4).
  password_hash   String?
  // USER | GESTIONNAIRE | ADMIN : contrainte CHECK en base (migration
  // 20261016120000_three_roles), liste de reference dans lib/roles.ts.
  role            String    @default("USER")
  // INVITED | ACTIVE | DISABLED : contraintes CHECK en base (migration
  // 20261016150000_whitelist_accounts), liste de reference dans lib/accounts.ts.
  status          String    @default("INVITED")
  first_login_at  DateTime?
  // Recopiee dans le jeton a la connexion ; augmentee a chaque remise a zero
  // ou desactivation, elle coupe les sessions ouvertes (D20, lib/auth.ts).
  session_version Int       @default(0)
  createdAt       DateTime  @default(now())
  // Les donnees dont ce compte est le dernier auteur (etape 5, D10) ; la cle
  // RESTRICT garde son nom tant qu'il en reste une (D24).
  updatedSchools                  School[]
  updatedCampuses                 Campus[]
  updatedPrograms                 Program[]
  updatedPricingRecords           PricingRecord[]
  updatedCapacityRecords          CapacityRecord[]
  updatedRankingRecords           RankingRecord[]
  updatedSchoolStatsRecords       SchoolStatsRecord[]
  updatedAccreditationRecords     AccreditationRecord[]
  updatedProgramCampusAttachments ProgramCampusAttachment[]
}

model School {
  id              String                @id @default(uuid())
  name            String                @unique
  official_domain String                @unique
  status          String                @default("ACTIVE")
  accreditations  AccreditationRecord[]
  campuses        Campus[]
  contributions   ContributionInbox[]
  pipelineJobs    PipelineJob[]
  programs        Program[]
  statsRecords    SchoolStatsRecord[]

  // Provenance (plan gestion-contenu, etape 5, D10 et D11), sur les neuf tables
  // de donnees. Facultative : une ligne d'avant la migration
  // 20261019120000_content_provenance n'en a pas. Posee par le code avec
  // l'auteur de la session (lib/provenance.ts), pas par la date automatique
  // de Prisma. La cle
  // RESTRICT empeche de supprimer un compte qui a modifie une donnee (D24).
  updated_at    DateTime?
  updated_by_id String?
  // MANUAL (saisie) | AI (validee depuis l'inbox) | REPORT (etape 6) : CHECK en base.
  updated_via   String?
  updatedBy     User?     @relation(fields: [updated_by_id], references: [id], onDelete: Restrict)
}

// Etat d'avancement du pipeline (Phase 1, Phase 2, recherche ciblee).
//
// Cet etat vivait dans deux dictionnaires de module de backend/routers/internal.py,
// dans un processus unique, sur un hebergeur qui redemarre. Au redemarrage, un job
// "running" disparaissait sans jamais passer a "failed" : comme les points d'entree
// refusent de lancer un scan quand un job tourne deja sur l'ecole, l'ecole restait
// verrouillee sans que rien ne l'indique.
//
// Ecrit exclusivement par le backend Python (psycopg2), via backend/pipeline_jobs.py.
// updated_at sert de battement de coeur : un job actif dont l'horodatage a vieilli
// est repute mort et repasse en "failed".
model PipelineJob {
  id          String    @id @default(uuid())
  schoolId    String
  phase       String
  // "manual" (panneau admin) | "rotation" (passes dues, run_due_passes).
  // "cron" : ancien cron research_rotation, supprime le 14/10/2026 ; des lignes
  // le portent encore. Voir backend/pipeline_jobs.py (ROTATION_SOURCES).
  source      String    @default("manual")
  // "queued" | "running" | "completed" | "failed"
  status      String    @default("queued")
  // Processus proprietaire du job : sert a detecter les jobs orphelins d'un
  // redemarrage. Voir backend/pipeline_jobs.py (WORKER_ID).
  worker_id   String?
  progress    Json?
  result      Json?
  error       String?
  started_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())
  finished_at DateTime?
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([status, updated_at])
}

model Campus {
  id              String              @id @default(uuid())
  schoolId        String
  name            String
  city            String?
  contributions   ContributionInbox[]
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programCampuses ProgramCampus[]

  // Provenance (etape 5) : voir School.
  updated_at    DateTime?
  updated_by_id String?
  updated_via   String?
  updatedBy     User?     @relation(fields: [updated_by_id], references: [id], onDelete: Restrict)

  @@unique([schoolId, name])
}

model Program {
  id                        String           @id @default(uuid())
  schoolId                  String
  name                      String
  admission_exam            String?
  is_alternance_possible    Boolean          @default(false)
  is_expatriation_mandatory Boolean          @default(false)
  min_expatriation_months   Int?
  max_internship_months     Int?
  // La phrase que la fiche pose AU-DESSUS de la liste par annee, et qui la
  // contredit parfois : l'IBBA enumere Paris 1, Dublin 2, Dubai 3, Oxford 4
  // puis ouvre par « Paris reste accessible chaque annee, avec au moins une
  // annee obligatoire sur l'un des campus internationaux ». Conservee en clair,
  // pour l'admin qui arbitre ; aucune requete ne s'appuie dessus.
  campus_policy_note        String?
  // Lien source de la fiche (D12, etape 5).
  source_url                String?
  campuses                  ProgramCampus[]
  placements                ProgramPlacement[]
  contributions             ContributionInbox[]
  pricingRecords            PricingRecord[]
  school                    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rankingRecords            RankingRecord[]

  // Provenance (etape 5) : voir School.
  updated_at    DateTime?
  updated_by_id String?
  updated_via   String?
  updatedBy     User?     @relation(fields: [updated_by_id], references: [id], onDelete: Restrict)

  @@unique([schoolId, name])
}

model ProgramCampus {
  id              String           @id @default(uuid())
  programId       String
  campusId        String
  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  campus          Campus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  capacityRecords CapacityRecord[]
  contributions   ContributionInbox[]
  attachments     ProgramCampusAttachment[]

  @@unique([programId, campusId])
}

// Le detail annee par annee d'un rattachement programme <-> campus.
//
// Les fiches d'EM Normandie publient une section « Campus de rattachement » qui
// donne le lieu ANNEE PAR ANNEE, et le meme campus y revient sur plusieurs
// annees : le Bachelor en Management en 3 ans nomme Le Havre en 1re, en 2e et
// en 3e annee. La ligne ProgramCampus, unique sur (programId, campusId), ne
// peut pas porter cette repetition ; elle est ici deportee sur une table fille.
//
// ProgramCampus garde donc son identite et son unicite : c'est elle qui porte
// CapacityRecord (unique sur (programCampusId, academic_year)), que la Phase 2
// enumere et que l'ecran admin manipule. Rien de tout cela ne bouge.
//
// ZERO ligne ici = le sens actuel, inchange : « ce programme est ouvert sur ce
// campus », sans decoupage par annee. Les fiches qui publient un simple choix
// de campus (l'alternance du Bachelor : Caen, Le Havre ou Paris) n'en creent
// aucune. La migration est donc purement additive : aucune ligne existante ne
// change de sens.
model ProgramCampusAttachment {
  id              String        @id @default(uuid())
  programCampusId String
  // 1 pour la 1re annee, 2 pour la 2e... Une plage annoncee en bloc
  // (« 4e et 5e annees ») donne une ligne par annee.
  study_year      Int
  // "INITIAL" | "ALTERNANCE" | "ANY". ANY quand la fiche ne distingue pas les
  // deux regimes sur cette annee — c'est le cas le plus courant. La 3e annee du
  // Bachelor, elle, publie deux listes de campus differentes, une par regime.
  regime          String        @default("ANY")
  // Langues d'enseignement attachees au couple (annee, campus) : Le Havre en
  // 1re annee est en anglais OU en francais, Paris en francais seulement.
  languages       String[]      @default([])
  note            String?
  source_url      String?
  programCampus   ProgramCampus @relation(fields: [programCampusId], references: [id], onDelete: Cascade)

  // Provenance (etape 5) : voir School.
  updated_at    DateTime?
  updated_by_id String?
  updated_via   String?
  updatedBy     User?     @relation(fields: [updated_by_id], references: [id], onDelete: Restrict)

  @@unique([programCampusId, study_year, regime])
}

// Un lieu d'etudes annonce par la fiche qui n'est PAS un campus de l'ecole.
//
// « Universite partenaire », « UniLaSalle Rouen », « Campus de Paris +
// International », « Lyon, Milan, Londres » : les fiches melangent, dans le
// meme champ, des campus du parc et des destinations qui n'en sont pas. Les
// creer dans Campus ferait entrer chez l'ecole des lieux qui ne lui
// appartiennent pas — et Campus alimente la liste des campus partout ailleurs.
//
// Cette table les REJETTE du parc tout en les conservant. Un programme dont le
// seul lieu est ici (le MS Agroalimentaire, sur « UniLaSalle Rouen ») se
// retrouve sans ProgramCampus : la Phase 2 ne lui genere aucune tache Capacity
// et l'import de crowdsourcing l'ecarte deja avec « aucun campus rattache ».
// C'est le comportement voulu : on ne connait pas les places de l'ecole sur le
// campus d'un tiers.
model ProgramPlacement {
  id         String  @id @default(uuid())
  programId  String
  // 0 = annee non precisee (« Campus de Paris + International », qui ne dit pas
  // quand). Sentinelle et non NULL : sous PostgreSQL deux NULL sont distincts,
  // et un @@unique nullable laisserait entrer le meme lieu deux fois.
  study_year Int     @default(0)
  regime     String  @default("ANY")
  // Le libelle tel que la fiche l'ecrit, sans normalisation.
  label      String
  // "PARTNER" (Universite partenaire, UniLaSalle Rouen, Institut Lyfe)
  // "REGION"  (International, Europe, Quebec (Region))
  // "REMOTE"  (Online, e-learning)
  // "UNSPECIFIED"
  kind       String  @default("UNSPECIFIED")
  note       String?
  source_url String?
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, study_year, regime, label])
}

model PricingRecord {
  id                    String  @id @default(uuid())
  programId             String
  academic_year         Int
  currency              String  @default("EUR")
  year_1_fee            Int?
  year_2_fee            Int?
  year_3_fee            Int?
  year_4_fee            Int?
  year_5_fee            Int?
  total_fee             Int?
  intl_year_1_fee       Int?
  intl_total_fee        Int?
  intl_currency         String?
  additional_fees_notes String?
  source_url            String?
  program               Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Provenance (etape 5) : voir School.
  updated_at    DateTime?
  updated_by_id String?
  updated_via   String?
  updatedBy     User?     @relation(fields: [updated_by_id], references: [id], onDelete: Restrict)

  @@unique([programId, academic_year])
}

model CapacityRecord {
  id              String        @id @default(uuid())
  programCampusId String
  academic_year   Int
  spots_available Int
  source_url      String?
  programCampus   ProgramCampus @relation(fields: [programCampusId], references: [id], onDelete: Cascade)

  // Provenance (etape 5) : voir School.
  updated_at    DateTime?
  updated_by_id String?
  updated_via   String?
  updatedBy     User?     @relation(fields: [updated_by_id], references: [id], onDelete: Restrict)

  @@unique([programCampusId, academic_year])
}

model RankingRecord {
  id            String  @id @default(uuid())
  programId     String
  academic_year Int
  ranking_name  String
  rank          Int
  source_url    String?
  program       Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Provenance (etape 5) : voir School.
  updated_at    DateTime?
  updated_by_id String?
  updated_via   String?
  updatedBy     User?     @relation(fields: [updated_by_id], references: [id], onDelete: Restrict)

  @@unique([programId, academic_year, ranking_name])
}

model SchoolStatsRecord {
  id                           String @id @default(uuid())
  schoolId                     String
  academic_year                Int
  total_students               Int?
  total_alumni                 Int?
  partner_companies            Int?
  annual_internship_offers     Int?
  abroad_campuses              Int?
  partner_universities         Int?
  permanent_professors         Int?
  international_professors_pct Float?
  external_speakers_pct        Float?
  source_url                   String? // D12, etape 5
  school                       School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Provenance (etape 5) : voir School.
  updated_at    DateTime?
  updated_by_id String?
  updated_via   String?
  updatedBy     User?     @relation(fields: [updated_by_id], references: [id], onDelete: Restrict)

  @@unique([schoolId, academic_year])
}

model AccreditationRecord {
  id                 String  @id @default(uuid())
  schoolId           String
  accreditation_name String
  // Nullable : l'annee d'obtention n'est pas toujours publiee. Elle valait 0
  // quand elle etait inconnue, et cette annee 0 partait en production comme une
  // donnee reelle -- la colonne etait Int non nullable, il fallait bien ecrire
  // quelque chose. "Inconnu" s'ecrit NULL.
  year_obtained      Int?
  is_active          Boolean @default(true)
  // "international" = EQUIS, AACSB, AMBA, BSIS… | "label" = CGE, Qualiopi, DD&RS… | "state" = Grade Master, CTI…
  accreditation_type String  @default("international")
  source_url         String? // D12, etape 5
  school             School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Provenance (etape 5) : voir School.
  updated_at    DateTime?
  updated_by_id String?
  updated_via   String?
  updatedBy     User?     @relation(fields: [updated_by_id], references: [id], onDelete: Restrict)

  @@unique([schoolId, accreditation_name])
}

model ContributionInbox {
  id                    String   @id @default(uuid())
  source_type           String
  schoolId              String?
  campusId              String?
  programId             String?
  programCampusId       String?
  user_text             String?
  urls                  String[]
  ai_category           String
  ai_extracted_json     Json?
  status                String   @default("Pending_AI")
  year_assumed          Boolean  @default(false)
  data_conflict_warning Boolean  @default(false)
  program_name_mismatch Boolean  @default(false)
  createdAt             DateTime @default(now())
  submission_group_id   String?
  // Rapport Tavily Research integral, tel que l'agent l'a redige.
  //
  // Le pipeline n'envoie plus de output_schema : Tavily redige, Gemini
  // structure. Conserver le texte source a deux usages, et les deux comptent.
  // L'admin arbitre sur pieces au lieu d'arbitrer sur un JSON creux : le
  // rapport porte les URL, les contradictions entre sources et ce que la
  // recherche n'a pas trouve. Et la donnee reste re-extractible si le schema
  // evolue, sans repayer un appel `pro` a 25 credits estimes.
  raw_report            String?

  // Relations posées apres coup. Les quatre colonnes etaient des String? sans
  // relation : rien n'empechait un ticket de referencer une entite supprimee, et
  // l'ecran d'arbitrage affichait alors un rattachement fantome.
  //
  // onDelete: SetNull, et non Cascade : la zone tampon est deliberement souple.
  // Supprimer une ecole ne doit pas detruire les contributions qui la visaient ;
  // le ticket se detache, l'admin voit qu'il ne pointe plus sur rien.
  school                School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  campus                Campus?        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  program               Program?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  programCampus         ProgramCampus? @relation(fields: [programCampusId], references: [id], onDelete: SetNull)

  @@index([submission_group_id])
  // Index sur les colonnes de rattachement : l'ecran d'inbox filtre sur
  // schoolId, et une suppression d'ecole ou de programme doit trouver les
  // tickets a detacher sans parcourir la table.
  @@index([schoolId])
  @@index([programId])
  // La file de traitement filtre sur status et trie sur createdAt a chaque
  // passage (toutes les minutes). Aucun index ne couvrait ces colonnes.
  @@index([status, createdAt])
}
