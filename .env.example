# ═══════════════════════════════════════════════════════════════════════════
#  Veille Concurrentiel — variables d'environnement
# ═══════════════════════════════════════════════════════════════════════════
#
#  Copier ce fichier en `.env.local` (Next.js) et en `backend/.env` (FastAPI),
#  puis renseigner les valeurs. Aucune valeur réelle ne doit être commitée.
#
#  Légende :  [REQUIS]  l'application ne démarre pas sans
#             [PROD]    requis en production uniquement
#             [OPTION]  a un défaut raisonnable
#
#  Ce fichier a été produit à l'étape 6 de l'audit technique. Auparavant, aucune
#  des variables n'était documentée à la racine : il fallait parcourir
#  docs/architecture/task.md pour en reconstituer la liste.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  BASE DE DONNÉES  (Next.js + FastAPI)
# ───────────────────────────────────────────────────────────────────────────

# [REQUIS] Connexion applicative. Sur Neon, l'URL du pooler (PgBouncer).
# Sur Vercel, l'intégration Neon l'injecte sous ce nom : ne pas la saisir à la
# main. Le build (`prisma generate`) exige qu'elle existe, sans se connecter.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# [REQUIS sur le poste] Connexion directe, sans pooler — utilisée par les
# migrations (`npm run db:status`, `npm run db:migrate`, CLI Prisma).
# PgBouncer ne supporte pas les migrations. Inutile sur Vercel : les
# migrations partent du poste, et prisma.config.ts se replie sur DATABASE_URL.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# [OPTION] Base jetable pour `prisma migrate dev` et
# `prisma migrate diff --from-migrations`. Prisma 7 EXIGE cette variable pour
# régénérer une migration depuis l'historique. Sans elle, il en crée une à la
# volée sur le serveur.
# SHADOW_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/shadow?sslmode=require"

# [OPTION] Pilote de connexion. POSTE LOCAL SEULEMENT, JAMAIS SUR VERCEL.
# Sur un réseau où le port 5432 est fermé (seuls 80 et 443 sortent), "neon-ws"
# fait tout passer par le proxy WebSocket de Neon (wss://<hôte>/v2, port 443) :
#   - côté Node, dans .env.development.local : `npm run db:status` et
#     `npm run db:migrate` passent par @neondatabase/serverless au lieu de la
#     CLI Prisma (Next.js est déjà en WebSocket et ne lit pas cette variable) ;
#   - côté Python, dans backend/.env : psycopg2 passe par un pont local sur
#     127.0.0.1 (backend/neon_ws_bridge.py).
# Absente : connexion directe en 5432, comme avant. Toute autre valeur est
# refusée au démarrage.
# DB_DRIVER="neon-ws"

# [OPTION] backend/.env, avec DB_DRIVER="neon-ws" seulement : port d'écoute du
# pont local, sur 127.0.0.1. Absente : un port libre choisi au démarrage.
# Entier de 1 à 65535, sinon le démarrage du pool échoue.
# NEON_WS_BRIDGE_PORT=6543


# ───────────────────────────────────────────────────────────────────────────
#  AUTHENTIFICATION  (Next.js)
# ───────────────────────────────────────────────────────────────────────────

# [REQUIS] Secret de signature des JWT NextAuth. Générer avec :
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# [REQUIS EN PROD] URL publique de l'application. NextAuth v4 en a besoin pour
# construire ses URLs de rappel. Absente du code, elle n'en est pas moins
# obligatoire. Sur Vercel : environnement Production seulement (en Preview,
# next-auth déduit l'adresse de la requête).
NEXTAUTH_URL="http://localhost:3000"

# [REQUIS pour `prisma db seed`] Mot de passe du compte administrateur initial.
# 12 caractères minimum, 72 octets maximum (limite bcrypt).
# Le seed ÉCHOUE si cette variable est absente : il n'existe plus de mot de
# passe par défaut. Voir docs/architecture/architecture.md §3.6.
SEED_ADMIN_PASSWORD=""

# [OPTION] Identifiant du compte administrateur initial. Défaut : admin
# SEED_ADMIN_USERNAME="admin"


# ───────────────────────────────────────────────────────────────────────────
#  LIAISON Next.js ↔ FastAPI
# ───────────────────────────────────────────────────────────────────────────

# [LOCAL SEULEMENT] URL du backend FastAPI, vue depuis le Next.js du poste.
# Le backend n'est plus hébergé : il tourne sur le poste de l'admin. Ne jamais
# la poser sur Vercel. Absente, /admin/cron affiche « pilotage depuis le poste
# local » et ne joint aucun backend (plus de repli sur localhost:8000).
FASTAPI_URL="http://localhost:8000"

# [LOCAL SEULEMENT] Jeton partagé de l'API interne. MÊME VALEUR des deux côtés
# (.env.local et backend/.env). Ne jamais le poser sur Vercel. Absent alors que
# FASTAPI_URL est posée : les routes répondent 500 TOKEN_MISSING.
#
# ⚠️  Ce secret portait trois noms : Next.js envoyait FASTAPI_INTERNAL_TOKEN,
#     FastAPI attendait INTERNAL_API_TOKEN ou INTERNAL_TOKEN. INTERNAL_API_TOKEN
#     est désormais le nom canonique ; les deux autres restent acceptés, mais
#     sont à supprimer de vos environnements.
INTERNAL_API_TOKEN=""


# ───────────────────────────────────────────────────────────────────────────
#  LIMITATION DE DÉBIT  (Next.js)
# ───────────────────────────────────────────────────────────────────────────

# [PROD — fortement recommandé] Magasin partagé pour les compteurs de débit.
# Sans lui, le repli mémoire s'applique : chaque démarrage à froid d'une
# fonction serverless repart d'un compteur vide, et le plafond ne tient plus.
# Base Redis créée sur console.upstash.com (offre gratuite), valeurs de
# l'onglet REST API. Ces noms exacts : KV_REST_API_URL / KV_REST_API_TOKEN
# (ancien Vercel KV) ne sont pas lus. Voir
# docs/memory/memory-deploiement-vercel.md §5.
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""


# CONTRIBUTION_ALLOWED_DOMAINS n'est plus lue : la contribution du public est
# retirée (plan gestion-contenu, étape 1, décision D2). Une valeur restée dans
# .env.local est sans effet.


# ═══════════════════════════════════════════════════════════════════════════
#  BACKEND FastAPI  —  à placer dans backend/.env
# ═══════════════════════════════════════════════════════════════════════════

# [REQUIS] Même valeur que ci-dessus.
# DATABASE_URL="..."
# INTERNAL_API_TOKEN="..."

# [REQUIS] Clé de l'API Google Gemini / Gemma.
GEMINI_API_KEY=""

# [REQUIS] Clés Tavily. Trois formats acceptés, dans cet ordre de priorité :
#   TAVILY_API_KEYS="cle1,cle2,cle3"     — plusieurs clés en rotation
#   TAVILY_API_KEY_1 … TAVILY_API_KEY_10 — une variable par clé
#   TAVILY_API_KEY                        — clé unique
TAVILY_API_KEY=""

# Le backend tourne sur le poste de l'admin et n'écoute que sur 127.0.0.1 :
# ENVIRONMENT, ALLOWED_ORIGINS, CRON_RESEARCH_ENABLED, CRON_RESEARCH_HOUR et
# CRON_ROTATION_PASSES_PER_NIGHT n'existent plus (14 octobre 2026,
# docs/features/backend-local.md étape 3) : le code ne les lit pas. /docs reste
# ouvert, et CORS n'accepte que http://localhost:3000.

# [OPTION] Passes dues, lancées sur demande par POST /internal/run-due-passes
# (dry_run=true pour voir le plan sans rien dépenser). Aucun job planifié ne
# paie Research. Voir docs/architecture/architecture.md §5.5.
# Lues une fois, au démarrage. Une valeur non entière ou hors bornes retombe
# sur le défaut, avec un avertissement dans les logs : elle ne fait pas tomber
# le démarrage. Le préfixe CRON_ est historique.
# CRON_MONTHLY_CREDIT_CEILING=7000           # plafond des passes dues, crédits Tavily
#                                            # estimés sur le mois calendaire UTC (≥ 0),
#                                            # recalés sur /usage avant chaque passe.
#                                            # 0 = aucune passe ne tient.
#                                            # ⚠️ Illisible → 7000, PAS 0.
# CRON_RESEARCH_INTERVAL_DAYS=182            # écart entre deux passages réussis (≥ 1)
# CRON_RESEARCH_RETRY_FAILED_DAYS=14         # écart après un passage en échec (≥ 1)
# PIPELINE_JOB_ROTATION_RETENTION_DAYS=400   # rétention des jobs de passage complet
#                                            # (≥ 1). DOIT rester supérieure à
#                                            # CRON_RESEARCH_INTERVAL_DAYS : une
#                                            # école purgée paraît « jamais passée »
#                                            # et serait repayée. Rien ne le vérifie.

# [OPTION] Traitement des contributions : première passe dès le démarrage du
# backend, puis toutes les N minutes (≥ 1). Une valeur illisible retombe sur 1,
# avec un avertissement. ⚠️ Il appelle Tavily et Gemma dès qu'il trouve des
# tickets Pending_AI : lancer le backend suffit à payer.
# CRON_CROWDSOURCING_INTERVAL_MINUTES=1

# [OPTION] Retention des tickets de contribution en echec.
# Voir docs/memory/decision-retention-tickets.md
# Attention au cout : chaque tentative relance une extraction Tavily facturee.
# CROWDSOURCING_MAX_ATTEMPTS=3               # tentatives avant suppression
# CROWDSOURCING_RETRY_DELAY_MINUTES=60       # delai avant nouvelle tentative
# PHASE2_MAX_PROGRAMS=10                     # programmes traités par passage
